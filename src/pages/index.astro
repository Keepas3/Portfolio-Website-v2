];

const courses = [
    { name: "Software Engineering", code: "CUS 1166", iconPath: "/src/assets/img/SE_icon.png" },
    { name: "Analysis of Algorithms", code: "CUS 1188", iconPath: "/src/assets/img/algorithms_icon.png" },
    { name: "Data Security/Cryptography", code: "CUS 1185", iconPath: "/src/assets/img/Cryptography.png" },
    { name: "Database Management Systems", code: "CUS 1166", iconPath: "/src/assets/img/dbms_icon.png" },
    { name: "Theory of Programming Languages", code: "CUS 1175", iconPath: "/src/assets/img/C++.png" },
    { name: "Operating Systems", code: "CUS 1163", iconPath: "/src/assets/img/operating_systems_icon.png" },
    { name: "Networking", code: "NET 1011", iconPath: "/src/assets/img/networking_icon.png" },
    { name: "Intro to Artificial Intelligence", code: "CUS 1174", iconPath: "/src/assets/img/AI_icon.png" },
