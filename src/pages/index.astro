---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import CourseCard from '../components/CourseCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Contact from '../components/Contact.astro';

import { getSiteSettings } from '../lib/sanity';
import { Image } from 'astro:assets';
import bryanSuit from '../assets/img/Bryan_Suit.jpg';
import facingForward from '../assets/img/Facing_forward.jpg';

const allImages = import.meta.glob('../assets/img/*.{png,jpg,jpeg,webp}');
const settings = await getSiteSettings();
const resumeUrl = settings.resumeUrl ?? '/Bryan_Fung_Resume.pdf';
const aboutHeadline = settings.aboutHeadline ?? 'Aspiring Software Developer & Engineer based in NYC';
const aboutParagraphs = settings.aboutParagraphs ?? [
  'I am eager to hone my skills and contribute to innovative projects that make a difference. Born and raised in New York City, I developed a passion for technology that led me to St. John\'s University, where I recently graduated with my Bachelor\'s degree in Computer Science.',
  'Outside of work and academics, I enjoy travelling, reading an interesting book, or playing a game of chess. Fun fact I play chess competitively in clubs & tournaments in New York. I\'m a big believer in staying active and using sports to keep my competitive edge sharp.',
  'Currently focusing on Digirips and Dragon Bot 2.0, projects that you can check out below. I\'m always open to connecting, so feel free to reach out if you\'d like to chat about potential opportunities or just want to say hi!',
];
const coreLanguages = settings.coreLanguages ?? 'Python, Java, C++, JavaScript, TypeScript, C, SQL, Rust';
const projectsBuilt = settings.projectsBuilt ?? '9+';

const myProjects = [
    {
        id: "campus-hub", 
        title: "SJU Campus Hub",
        video: "/videos/SJU_Campus_Hub.mp4",
        images: "/gallery/Hacks2025.png | /gallery/SJU_Campus_Hub_Group.png",
        description:  `Winner of the St. John's Track for St. John's Hacks 2025. A centralized platform designed to connect all events of St. John's University in one place.
                        Provides information about campus activities, club events, and study groups.`,
        fullDescription: `
            <div class="space-y-4">
                <p><strong>SJU Campus Hub</strong> is a centralized ecosystem designed to connect the St. John's community. We built this to solve the fragmentation of campus information, creating a hub for student life.</p>    
                <h4 class="font-bold text-slate-900 border-b pb-1">Key Features</h4>
                <ul class="list-disc pl-5 space-y-2 text-slate-600">
                    <li><strong>Unified Event Tracking:</strong> Real-time information on campus activities, club meetings, and study sessions.</li>
                    <li><strong>Team Collaboration:</strong> Developed in the St. John's Hacks 2025hackathon in a team of 3 as the lead frontend developer.</li>
                    <li><strong>Modern Deployment:</strong> Optimized for performance using HTML/CSS and JavaScript being hosted via <strong>Vercel</strong> for seamless access.</li>
                </ul>

                <div class="bg-blue-50 border-l-4 border-blue-600 p-3 rounded-r-lg">
                    <p class="text-blue-700 italic font-medium">"Building for a Better Student Life!"</p>
                </div>
            </div>
        `,
        link: "https://github.com/Keepas3/SJU-Campus-Hub",
        techStack: "HTML/CSS | JavaScript | Vercel",
        award: "1st Place - SJU Hacks"
    },
    {
        id: "adapt-iq", 
        title: "AdaptIQ",
        video: "/videos/AdaptIQ-0.mp4",
        images: "/gallery/StJohnsHacks2026.jpg | /gallery/presentation.PNG |/gallery/ToltIQ.jpg",
        description: `3rd Place Winner of St. John's University Hacks 2026. AdaptIQ is a PowerPoint Add-on that uses LLMs and web APIs to analyze slide content in real-time, generate relevant images with DALL-E, and provide automated research assistance.
                      Features real-time slide analysis, DALL-E image generation, and multi-format summary exports.`,
        fullDescription: `
        <div class="space-y-4">
            <p><strong>AdaptIQ</strong> is an intelligent PowerPoint Add-on that bridges the gap between slide design and active research. Built to streamline the workflow for professionals, it acts as a real-time sidekick during the content creation process.</p>
            <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Key Innovations</h4>
            <ul class="list-disc pl-5 space-y-2 text-slate-600">
                <li><strong>Context Parsing:</strong> Analyzes slide text via <strong>OpenAI</strong> to understand the core subject matter.</li>
                <li><strong>Automated Imagery:</strong> Integrated <strong>DALL-E</strong> API to generate visuals based on the content.</li>
                <li><strong>Deep Research:</strong> Leverages the <strong>Tavily API</strong> to pull real-time data and citations directly into the presentation.</li>
            </ul>
            <div class="bg-amber-50 border-l-4 border-amber-500 p-3 rounded-r-lg">
                <p class="text-amber-800 text-xs font-medium">🏆 3rd Place ToltIQ Track — St. John's University Hacks 2026</p>
            </div>
        </div>
    `,
        link: "https://github.com/Keepas3/adapt-iq",
        techStack: "Tailwind CSS | Tavily API | TypeScript | OpenAI API",
        award: "3rd Place - SJU Hacks"
    },
    {
        id: "freelance-web-development", 
        title: "Freelance Web Development",
        video: "/videos/seasaide.mp4", 
        description: "A collection of custom websites I built for clients, businesses, and personal brands using modern web technologies. Each project being tailored to their specific needs and goals. Learn more about the projects below.",
        fullDescription: `
            <div class="space-y-4">
                <p class="text-sm text-slate-600">A showcase of custom websites I have built. Select a project below, then use the tabs at the top of the video player to toggle between the live site and its CMS dashboard.</p>

                <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-3 mb-4">
                    <div class="freelance-project-tab cursor-pointer bg-blue-100 text-blue-700 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-project="seasaide">Seasaide</div>
                    <div class="freelance-project-tab cursor-pointer bg-slate-100 text-slate-600 hover:bg-slate-200 px-3 py-1.5 rounded-lg text-xs font-bold transition-colors" data-project="sound-archives">Sound Archives</div>
                </div>
                <style>
                .link-hover {
                    color: #1d4ed8; 
                    text-decoration: none; /* No underline */
                    transition: color 0.3s ease; /* Smooth color change */
                }
                .link-hover:hover {
                    color: #dc2626; /* Hover color (red) */
                }
                </style>
                <div id="desc-seasaide-front" class="freelance-desc block space-y-4 animate-fade-in">
                    <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Seasaide:
                    <a href="https://www.seasaide.cyou/" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="link-hover">
                        Visit Seasaide
                    </a>     </h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Developed a custom-tailored personal hub to showcase client's personal identity. The site acts as a <strong>unified archive</strong> for blogs, media, and projects.
                        <br><br>
                        Additionally featuring live integration with Spotify's API for real-time music and listening activity display. The background has falling sakura leaves as requested by the client.
                    </p>
                    <div class="bg-green-100 border-l-4 border-green-600 p-3 rounded-r-lg">
                        <p class="text-green-500 italic font-medium">Check out the sanity.io backend where client's can manage their content without touching any code.</p>
                    </div>
                </div>

                <div id="desc-seasaide-back" class="freelance-desc hidden space-y-4 animate-fade-in">
                    <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Seasaide: CMS Dashboard</h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Integrated with Sanity.io dashboard allowing where the client can adjust the site's content, add new blog posts, add songs or projects, and manage media without touching any code.
                        <br>
                        The dashboard is fully customized and almost all the text, images, and media on the site can be changed based on the client's needs.
                    </p>
                    <div class="bg-green-100 border-l-4 border-green-600 p-3 rounded-r-lg mt-4">
                        <p class="text-green-500 text-xs font-medium">Takes up to 3 minutes for the site to update changes meaning very little downtime.</p>
                    </div>
                </div>

                <div id="desc-sa-front" class="freelance-desc hidden space-y-4 animate-fade-in">
                    <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Sound Archives:
                    <a href="https://andrew-portfolio-ten-lac.vercel.app/" 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="link-hover">
                        Visit Sound Archives
                    </a>   </h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        A portfolio site designed for a client to showcase their collection of audio projects. It features a real-time audio visualizer platform synchronized with the global music player at the bottom of the webpage.
                        <br><br>
                        The visualizer is built with the audio analyzer and mapped to the frequency spectrum of the audio being played. The global player is a complete list of all audio tracks added on by the client in the album section.
                    </p>
                    <div class="bg-red-100 border-l-4 border-red-600 p-3 rounded-r-lg mt-4">
                        <p class="text-red-500 text-xs font-medium">Check the dashboard tab to see how albums are created & songs added to the global player.</p>
                    </div>
                </div>

                <div id="desc-sa-back" class="freelance-desc hidden space-y-4 animate-fade-in">
                    <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Sound Archives: CMS</h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        The Sanity.io dashboard backend allows client to be able to edit content on their profiles, gallery, and add their own audio tracks to the site.
                        <br> The audio visualizer will dynamically change with every song added.
                    </p>
                    <div class="bg-indigo-50 border-l-4 border-indigo-600 p-3 rounded-r-lg mt-4">
                        <p class="text-indigo-700 text-xs font-medium">Audio file uploads automatically populate the global player in real-time.</p>
                    </div>
                </div>
            </div>
        `,
        link: "https://github.com/Keepas3",
        techStack: "Next.js | Sanity.io | Astro | Tailwind CSS"
    },
    {
        id: "dragon-bot-v2",
        title: "Dragon Bot 2.0",
        videoBot: "/videos/Bot_Demo.mp4",
        videoWeb: "/videos/Video_Demo.mp4",
        description: `A Discord Bot providing real-time clan tracking, smart war & raid reminders with automatic notifications.
                      Includes a direct feed to the latest leaks and news from Reddit.`,
        fullDescription: `
        <div class="space-y-4">
            <p><strong>Dragon Bot 2.0</strong> is a Discord Bot designed for clan management and tracking. Where to get started? Check out the Website! </p>
            <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">Core Capabilities</h4>
            <ul class="list-disc pl-5 space-y-2 text-slate-600">
                <li><strong>Live Clan Tracking:</strong> Real-time monitoring of performance metrics, player and opponent statistics, and clan activities.</li>
                <li><strong>Smart Reminders:</strong> Automated war and raid notifications that ensure members never miss their attacks.</li>
                <li><strong>News Aggregator:</strong> Direct integration with <strong>Reddit API</strong> to deliver the latest leaks and updates in real-time.</li>
            </ul>
            <div class="bg-indigo-50 border-l-4 border-indigo-600 p-3 rounded-r-lg">
                <p class="text-indigo-700 text-xs font-medium">Built with a scalable Python backend and a modern Astro/Tailwind web interface.</p>
            </div>
        </div>
    `,
        link: "https://github.com/Keepas3/Dragon-Bot-2.0",
        techStack: "Python | Discord API | Railway | Reddit API | Astro | Tailwind CSS"
    },
    {
        id: "vcrts", 
        title: "VCRTS",
        video: "/videos/VCRTS.mp4",
        description: `A distributed cloud computing system that leverages parked vehicles' computational resources. 
                      Features real-time job and vehicle scheduling, resource allocation, and a GUI for both clients and admins. 
                      Built by a team of 5 developers as a capstone project.`,
        fullDescription: `
        <div class="space-y-4">
            <p><strong>VCRTS (Vehicular Cloud Resource Tracking System)</strong> is a distributed computing platform designed to harness the idle processing power of parked vehicles. In short, this capstone project focused on resource optimization.</p>
            <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">System Architecture</h4>
            <ul class="list-disc pl-5 space-y-2 text-slate-600">
                <li><strong>Job Scheduling:</strong> An algorithmic approach to resource allocation based on vehicle availability and job priority.</li>
                <li><strong>Dual-GUI Design:</strong> Dedicated interfaces for both system admins (resource management) and clients (job submission).</li>
                <li><strong>Persistent Data:</strong> Powered by a robust <strong>MySQL</strong> backend to ensure zero data loss during node handoffs.</li>
            </ul>
            <div class="bg-slate-100 border-l-4 border-slate-900 p-3 rounded-r-lg">
                <p class="text-slate-700 text-xs font-bold uppercase tracking-tighter">Capstone Project — Team of 5 Developers</p>
            </div>
        </div>
    `,
        link: "https://github.com/Alegacki21/VCRTS-SWE-Project",
        techStack: "Java | Java Swing | MYSQL"
    },
    {
        id: "video-recap", 
        title: "Video Recap",
        video: "/videos/video_recap.mp4",
        description: `Designed to condense YouTube videos into short, concise sentences for quick understanding of lengthy content. Utilizes OpenRouter AI and YouTube transcripts to generate summaries.
                      Developed during the SJU ACM x HeadStarter Hackathon 2024 in a team of 4 developers.`,
        fullDescription: `
        <div class="space-y-4">
            <p><strong>Video Recap</strong> was born from a simple problem: the information density of YouTube is too high for quick consumption. This tool uses AI to transform long-form video transcripts into digestible, high-level summaries.</p>
            <h4 class="font-bold text-slate-900 border-b pb-1 uppercase text-xs tracking-wider">The Stack</h4>
            <ul class="list-disc pl-5 space-y-2 text-slate-600">
                <li><strong>AI Orchestration:</strong> Utilized <strong>OpenRouter AI</strong> to access the best-performing LLMs for text summarization.</li>
                <li><strong>Natural Language Processing:</strong> Integrated <strong>Hugging Face Transformers</strong> to refine the transcript analysis process.</li>
                <li><strong>Data Retrieval:</strong> Automated the extraction of YouTube transcripts to ensure 100% accuracy in source data.</li>
            </ul>
            <div class="bg-blue-50 border-l-4 border-blue-600 p-3 rounded-r-lg">
                <p class="text-blue-700 text-xs font-medium">Built during the SJU ACM x HeadStarter Hackathon 2024 — Team of 4.</p>
            </div>
        </div>
    `,
        link: "https://github.com/Keepas3/VideoRecap-HeadStarterHackathon",
        techStack: "Python | OpenRouterAI | HTML/CSS | Hugging Face Transformer"
    }
];

const experienceData = [
    {
        title: "Data Analyst",
        company: "St. John's University - Facilities Department",
        location: "Queens, NY",
        date: "Spring 2025 - Spring 2026", 
        logo: "/src/assets/img/SJU_logo.png",
        bullets: [
            "Analyzed university data to identify cost-saving opportunities and track usage trends across multiple campuses.",
            "Applied advanced Excel and SQL queries to optimize resource allocations and budget accuracy.",
            "Delivered data-driven insights to assist in financial forecasting and cost-saving initiatives."
        ]
    },
    {
        title: "AI Intern",
        company: "SJ Innovation LLC",
        location: "New York, NY",
        date: "Summer 2024",
        logo: "/src/assets/img/SJ_Innovation_Logo.png",
        bullets: [
