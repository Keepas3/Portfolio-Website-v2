<script>
// ==========================================
// 1. DATA MAP FOR FREELANCE DYNAMIC TOP TABS
// ==========================================
const freelanceProjectsData = {
    "seasaide": [
        { label: "Live Site", video: "/videos/seasaide.mp4", target: "desc-seasaide-front" },
        { label: "Backend", video: "/videos/seasaide_backend.mp4", target: "desc-seasaide-back" }
    ],
    "sound-archives": [
        { label: "Live Site", video: "/videos/sound-archives.mp4", target: "desc-sa-front" },
        { label: "Dashboard", video: "/videos/sound_archives_backend.mp4", target: "desc-sa-back" }
    ]
};

document.addEventListener("DOMContentLoaded", () => {
    
    /* =========================================
       2. TOOLKIT HOVER LOGIC (UPDATED FOR DARK MODE)
       ========================================= */
    const icons = document.querySelectorAll('.hover-icon');
    const label = document.getElementById('toolkit-label');
    const defaultText = "Hover over a tool to see how I use it.";

    if (icons.length > 0 && label) {
        icons.forEach(icon => {
            icon.addEventListener('mouseenter', () => {
                const context = icon.getAttribute('data-context');
                label.style.opacity = '0'; 
                setTimeout(() => {
                    label.textContent = context;
                    label.classList.remove('text-slate-500', 'dark:text-slate-400');
                    label.classList.add('text-slate-800', 'dark:text-white', 'font-semibold'); 
                    label.style.opacity = '1';
                }, 150); 
            });
            icon.addEventListener('mouseleave', () => {
                label.style.opacity = '0';
                setTimeout(() => {
                    label.textContent = defaultText;
                    label.classList.remove('text-slate-800', 'dark:text-white', 'font-semibold');
                    label.classList.add('text-slate-500', 'dark:text-slate-400'); 
                    label.style.opacity = '1';
                }, 150);
            });
        });
    }

    /* =========================================
       3. PROJECT MODAL LOGIC & UI ELEMENTS
       ========================================= */
    const modal = document.querySelector('#project-modal');
    const modalVideo = document.querySelector('#modal-video');
    const modalVideoSource = document.querySelector('#modal-video source');
    const modalGalleryContainer = document.querySelector('#modal-gallery-container');
    const modalGallery = document.querySelector('#modal-gallery');
    
    const projectCards = document.querySelectorAll('.project-trigger');
    const closeButtons = document.querySelectorAll('.close-modal');
    
    const modalTitle = document.querySelector('#modal-title');
    const modalDesc = document.querySelector('#modal-description');
    const modalGithub = document.querySelector('#modal-github');

    const ecosystemTabs = document.querySelector('#ecosystem-tabs');
    const showVideoBtn = document.querySelector('#show-video');
    const showGalleryBtn = document.querySelector('#show-gallery');
    const prevBtn = document.querySelector('#prev-img');
    const nextBtn = document.querySelector('#next-img');

    let activeCard = null;

    function renderTopTabs(projectKey) {
        const tabsData = freelanceProjectsData[projectKey];
        if (!tabsData) return;

        let customTabsContainer = document.getElementById('injected-custom-tabs');
        if (!customTabsContainer && ecosystemTabs) {
            customTabsContainer = document.createElement('div');
            customTabsContainer.id = 'injected-custom-tabs';
            customTabsContainer.className = 'flex gap-2 ml-2';
            ecosystemTabs.parentNode.insertBefore(customTabsContainer, ecosystemTabs.nextSibling);
        }

        if (customTabsContainer) customTabsContainer.innerHTML = '';
        if (ecosystemTabs) ecosystemTabs.style.display = 'none';

        tabsData.forEach((tab, index) => {
            const btn = document.createElement('button');
            
            btn.className = index === 0 
                ? 'custom-video-btn bg-white/20 text-white px-3 py-1 rounded-md border border-gray-500 text-sm font-medium transition-colors' 
                : 'custom-video-btn bg-transparent hover:bg-white/10 text-white/70 px-3 py-1 rounded-md border border-gray-600 text-sm font-medium transition-colors';
            
            btn.textContent = tab.label;
            
            btn.onclick = () => {
                const allBtns = customTabsContainer.querySelectorAll('.custom-video-btn');
                allBtns.forEach(b => {
                    b.className = 'custom-video-btn bg-transparent hover:bg-white/10 text-white/70 px-3 py-1 rounded-md border border-gray-600 text-sm font-medium transition-colors';
                });
                btn.className = 'custom-video-btn bg-white/20 text-white px-3 py-1 rounded-md border border-gray-500 text-sm font-medium transition-colors';

                if (modalVideoSource && modalVideo) {
                    showView('video');
                    modalVideoSource.src = tab.video;
                    modalVideo.load();
                    const playPromise = modalVideo.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(error => console.log("Playback prevented: ", error));
                    }
                }

                if (modalDesc) {
                    const allDescs = modalDesc.querySelectorAll('.freelance-desc');
                    allDescs.forEach(d => {
                        d.classList.remove('block');
                        d.classList.add('hidden');
                    });
                    const targetDesc = modalDesc.querySelector('#' + tab.target);
                    if (targetDesc) {
                        targetDesc.classList.remove('hidden');
                        targetDesc.classList.add('block');
                    }
                }
            };
            customTabsContainer.appendChild(btn);
        });

        if (customTabsContainer && customTabsContainer.firstChild) {
            customTabsContainer.firstChild.click();
        }
    }

    projectCards.forEach((card) => {
        card.addEventListener('click', () => {
            activeCard = card; 
            showView('video');

            const title = card.getAttribute('data-title') || '';
            const githubLink = card.getAttribute('data-link') || '#';
            const richDescription = card.querySelector('.hidden-full-desc') ? card.querySelector('.hidden-full-desc').innerHTML : '';
            const videoBot = card.getAttribute('data-video-bot');
            const videoWeb = card.getAttribute('data-video-web');
            const defaultVideo = card.getAttribute('data-video') || videoBot || '';

            const gallerySource = card.querySelector('.hidden-gallery');
            const hasImages = gallerySource ? gallerySource.querySelectorAll('img').length > 0 : false;
            const galleryHTML = gallerySource ? gallerySource.innerHTML : '';
            
            if (showGalleryBtn) showGalleryBtn.style.display = hasImages ? 'flex' : 'none';
            if (modalGallery) {
                modalGallery.innerHTML = galleryHTML;
                modalGallery.scrollLeft = 0; 
            }

            if (modalTitle) modalTitle.textContent = title;
            if (modalDesc) modalDesc.innerHTML = richDescription;
            if (modalGithub) modalGithub.href = githubLink;

            let customTabsContainer = document.getElementById('injected-custom-tabs');
            if (customTabsContainer) customTabsContainer.innerHTML = '';

            if (title === "Freelance Web Development") {
                renderTopTabs('seasaide');
            } else {
                if (ecosystemTabs) {
                    ecosystemTabs.style.display = (videoBot && videoWeb) ? 'flex' : 'none';
                }
                if (modalVideoSource && modalVideo) {
                    modalVideoSource.src = defaultVideo;
                    modalVideo.load();
                }
            }

            if (modal) modal.showModal();
        });
    });

    if (modalDesc) {
        modalDesc.addEventListener('click', (e) => {
            const projectBtn = e.target.closest('.freelance-project-tab');
            if (projectBtn) {
                const allProjectBtns = modalDesc.querySelectorAll('.freelance-project-tab');
                allProjectBtns.forEach(b => {
                    b.classList.remove('bg-blue-100', 'text-blue-700');
                    b.classList.add('bg-slate-100', 'text-slate-600');
                });
                projectBtn.classList.remove('bg-slate-100', 'text-slate-600');
                projectBtn.classList.add('bg-blue-100', 'text-blue-700');

                const projectKey = projectBtn.getAttribute('data-project');
                renderTopTabs(projectKey);
            }
        });
    }

    function showView(type) {
        if (type === 'video') {
            if (modalVideo) modalVideo.classList.remove('hidden');
            if (modalGalleryContainer) modalGalleryContainer.classList.add('hidden');
            if (showVideoBtn) showVideoBtn.classList.add('bg-blue-600', 'text-white');
            if (showGalleryBtn) showGalleryBtn.classList.remove('bg-blue-600', 'text-white');
        } else {
            if (modalVideo) {
                modalVideo.classList.add('hidden');
                modalVideo.pause();
            }
            if (modalGalleryContainer) modalGalleryContainer.classList.remove('hidden');
            if (showGalleryBtn) showGalleryBtn.classList.add('bg-blue-600', 'text-white');
            if (showVideoBtn) showVideoBtn.classList.remove('bg-blue-600', 'text-white');
        }
    }

    function scrollGallery(direction) {
        if (!modalGallery) return;
        const scrollAmount = modalGallery.clientWidth; 
        modalGallery.scrollBy({ 
            left: direction === 'next' ? scrollAmount : -scrollAmount, 
            behavior: 'smooth' 
        });
    }

    if (showVideoBtn) showVideoBtn.addEventListener('click', () => showView('video'));
    if (showGalleryBtn) showGalleryBtn.addEventListener('click', () => showView('gallery'));
    if (prevBtn) prevBtn.addEventListener('click', () => scrollGallery('prev'));
    if (nextBtn) nextBtn.addEventListener('click', () => scrollGallery('next'));

    const ecoButtons = document.querySelectorAll('#ecosystem-tabs button');
    ecoButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            if (!activeCard || !modalVideo || !modalVideoSource) return;
            const type = btn.getAttribute('data-type');
            const videoSrc = activeCard.getAttribute(`data-video-${type}`);

            if (videoSrc) {
                showView('video'); 
                modalVideoSource.src = videoSrc;
                modalVideo.load();
                
                const playPromise = modalVideo.play();
                if (playPromise !== undefined) {
                    playPromise.catch(error => console.log("Video playback prevented: ", error));
                }

                ecoButtons.forEach(b => b.classList.remove('bg-white/40', 'text-white'));
                btn.classList.add('bg-white/40', 'text-white');
            }
        });
    });

    const closeModal = () => {
        if (modal) modal.close();
        if (modalVideo) modalVideo.pause();
    };

    closeButtons.forEach(btn => btn.addEventListener('click', closeModal));
    if (modal) {
        modal.addEventListener('click', (e) => { 
            if (e.target === modal) closeModal(); 
        });
    }
});
</script>