            </div>
        </div>
        <div class="reveal flex-1">
    <Image 
        src={bryanSuit} 
        alt="Bryan Fung" 
        class="rounded-3xl shadow-2xl w-full max-w-md mx-auto-0 transition-all duration-800"
    />
</div>
    </section>
    <section id="about" class="py-24 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
