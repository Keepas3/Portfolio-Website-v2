---

<MainLayout title="Bryan Fung | Software Engineer">
    <section class="min-h-screen flex flex-col md:flex-row items-center justify-center container mx-auto px-6 gap-12 transition-colors duration-300">
        <div class="reveal flex-1 text-center md:text-left">
            <h1 class="text-5xl md:text-7xl font-extrabold leading-tight text-slate-900 dark:text-white">
                Welcome,<br>I'm <span class="text-blue-600">Bryan Fung</span>
            </h1>
            <p class="text-xl text-slate-600 dark:text-slate-300 mt-6 max-w-lg">Aspiring Software Developer & Engineer based in NYC. </p>
            <div class="mt-10 flex gap-4 justify-center md:justify-start">
                <a 
                    href={resumeUrl}
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-8 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-full font-bold hover:bg-blue-600 dark:hover:bg-blue-50 transition-all active:scale-95 group"
                >
                    <span>View Resume</span>
                    <i class='bx bx-link-external text-lg group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform'></i>
                </a>
                <div class="flex items-center gap-4 text-3xl">
                    <a href="https://github.com/Keepas3" class="text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors" target ="_blank" rel="noopener noreferrer">
                        <i class='bx bxl-github'></i>
                    </a>
                    <a href="https://www.linkedin.com/in/bryan-fung-a2a089256/" class="text-slate-900 dark:text-white hover:text-blue-500 dark:hover:text-blue-400 transition-colors" target ="_blank" rel="noopener">
                        <i class='bx bxl-linkedin'></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="reveal flex-1">
            <Image 
                src={bryanSuit} 
                alt="Bryan Fung" 
                class="rounded-3xl shadow-2xl w-full max-w-md mx-auto-0 transition-all duration-800 border-4 border-transparent dark:border-slate-800"
            />
        </div>
    </section>

    <section id="about" class="py-24 bg-white dark:bg-slate-900 transition-colors duration-300">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
                <div class="reveal flex-1 w-full max-w-md">
                    <div class="relative group">
                        <div class="absolute -inset-4 bg-blue-50 dark:bg-blue-900/20 rounded-[2rem] -rotate-3 group-hover:rotate-0 transition-transform duration-500"></div>
                        <Image 
                            src={facingForward} 
                            alt="Bryan Fung Portrait" 
                            class="relative rounded-3xl shadow-xl w-full h-auto object-cover border-4 border-white dark:border-slate-800 transition-colors duration-300"
                        />
                    </div>
                </div>

                <div class="reveal flex-1">
                    <h2 class="text-sm font-black uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">About Me</h2>
                    <h3 class="text-4xl font-bold text-slate-900 dark:text-white mb-6 leading-tight transition-colors duration-300">
                        {aboutHeadline}
                    </h3>

                    <div class="space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed transition-colors duration-300">
                        {aboutParagraphs.map((para) => (
                            <p>{para}</p>
                        ))}
                    </div>

                    <div class="grid grid-cols-2 gap-6 mt-10 border-t border-slate-100 dark:border-slate-800 pt-8 transition-colors duration-300">
                        <div>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white transition-colors duration-300">Core Languages</p>
                            <p class="text-xs text-balance uppercase tracking-wide text-slate-400 dark:text-slate-500 font-medium transition-colors duration-300">
                                {coreLanguages}
                            </p>
                        </div>
                        <div>
                            <p class="text-2xl font-bold text-slate-900 dark:text-white transition-colors duration-300">{projectsBuilt}</p>
                            <p class="text-xs uppercase tracking-wide text-slate-400 dark:text-slate-500 font-bold transition-colors duration-300">Projects Built</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="Skills" class="py-16 bg-slate-50 dark:bg-slate-800/50 border-y border-slate-100 dark:border-slate-800/50 transition-colors duration-300">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <p class="text-[10px] uppercase tracking-widest text-slate-400 dark:text-slate-500 font-bold mb-6 transition-colors duration-300">My Core Toolkit</p>
            <div class="relative w-full mx-auto overflow-hidden" 
                 style="-webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);">
                <div class="flex w-max animate-infinite-scroll gap-6 px-4 py-4">
                    <div class="flex gap-6 items-center">
                        <div data-context="Configured cloud infrastructure and databases to support scalable application deployments." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
                            <img src="/toolkit/aws.png" alt="AWS" class="w-14 h-14 object-contain" />
                        </div>
                        <div data-context="Containerized deployments for Dragon Bot 2.0 to prevent conflicts across environments." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
                            <img src="/toolkit/docker.png" alt="Docker" class="w-14 h-14 object-contain" />
                        </div>
                        <div data-context="Integrated Firebase for real-time data handling and backend services in web applications." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
                            <img src="/toolkit/firebase.png" alt="Firebase" class="w-14 h-14 object-contain" />
                        </div>
                        <div data-context="Leveraged Google Cloud platforms to manage scalable systems and cloud databases." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
                            <img src="/toolkit/googlecloud.png" alt="Google Cloud" class="w-14 h-14 object-contain" />
                        </div>
                        <div data-context="Architected MySQL databases for persistent data storage for Vehicular Cloud real-time system and Dragon Bot 2.0." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
                            <img src="/toolkit/mySQL.png" alt="MySQL" class="w-14 h-14 object-contain" />
                        </div>
                        <div data-context="Developed robust Java-based backend infrastructure using the Spring Boot framework." class="hover-icon flex items-center justify-center w-20 h-20 bg-white dark:bg-slate-800 rounded-full shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md hover:-translate-y-1 transform transition-all duration-200 cursor-pointer">
