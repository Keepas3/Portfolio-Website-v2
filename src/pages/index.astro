                >
                    <span>View Resume</span>
                    <i class='bx bx-link-external text-lg group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform'></i>
                </a>
                <div class="flex items-center gap-4 text-3xl">
                    <a href="https://github.com/Keepas3" class="hover:text-blue-600" 
