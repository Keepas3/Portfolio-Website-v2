---
interface Props {
  title: string;
  description: string;
  url: string;
  imageUrl: string | null;
  techStack: string[];
}

const { title, description, url, imageUrl, techStack } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
>
  <!-- Thumbnail -->
  <div class="aspect-video w-full bg-slate-100 dark:bg-slate-700 overflow-hidden">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={`${title} preview`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-slate-300 dark:text-slate-600">
        <i class="bx bx-globe text-5xl"></i>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-6">
    <div class="flex items-start justify-between gap-2 mb-2">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        {title}
      </h3>
      <i class="bx bx-link-external text-slate-400 dark:text-slate-500 group-hover:text-blue-500 transition-colors flex-shrink-0 mt-0.5"></i>
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4 line-clamp-3 flex-1">
      {description}
    </p>

    <!-- Tech pills -->
    {techStack?.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-auto">
        {techStack.map((tech) => (
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 rounded-md">
            {tech}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
