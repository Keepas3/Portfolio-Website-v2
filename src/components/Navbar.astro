---
import { getResumeUrl } from '../lib/sanity';
const resumeUrl = (await getResumeUrl()) ?? '/Bryan_Fung_Resume.pdf';
const navLinks = [
  { name: 'About', href: '/about' },
  { name: 'Projects', href: '/projects' },
  { name: 'Experience', href: '/experience' },
  { name: 'Education', href: '/education' },
  { name: 'Contact', href: '/contact' },
];
---

<nav id="navbar" class="fixed top-0 w-full z-[100] transition-all duration-500 transform -translate-y-full opacity-0 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-100 dark:border-slate-800 py-2">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-black text-slate-900 dark:text-white tracking-tighter transition-colors duration-300">
            Bryan<span class="text-blue-600 dark:text-blue-400">Dev</span>
        </a>

        <div class="hidden md:flex items-center gap-8">
            {navLinks.map(link => (
                <a href={link.href} class="nav-link text-sm font-bold text-slate-600 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors uppercase tracking-widest">
                    {link.name}
                </a>
            ))}
            <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-xs font-bold rounded-full hover:bg-blue-600 dark:hover:bg-blue-50 transition-all shadow-lg shadow-slate-200 dark:shadow-none group">
                RESUME
                <i class='bx bx-export text-sm group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform'></i>
            </a>
        </div>

        <button class="md:hidden text-3xl text-slate-900 dark:text-white transition-colors duration-300" id="menu-btn">
            <i class='bx bx-menu-alt-right'></i>
        </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 p-6 flex flex-col gap-4 shadow-xl transition-colors duration-300">
        {navLinks.map(link => (
            <a href={link.href} class="nav-link text-lg font-bold text-slate-900 dark:text-white py-2 border-b border-slate-50 dark:border-slate-800 last:border-0 transition-colors duration-300">
                {link.name}
            </a>
        ))}
    </div>
</nav>

<script>
    // 1. Select all links with the .nav-link class
    const navLinks = document.querySelectorAll('.nav-link');
    const navbar = document.getElementById('navbar');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            const href = link.getAttribute('href'); 
            const targetId = href?.replace('/', ''); 
            const targetElement = document.getElementById(targetId || '');

            if (targetElement) {
                e.preventDefault(); 
                window.history.pushState({ section: targetId }, '', href || '/');
                targetElement.scrollIntoView({ behavior: 'smooth' });
                mobileMenu?.classList.add('hidden');
            }
        });
    });

    // 2. Scroll Effect (Show/Hide Navbar)
    window.addEventListener('scroll', () => {
        if (!navbar) return;
        if (window.scrollY > 150) {
            navbar.classList.remove('-translate-y-full', 'opacity-0');
            navbar.classList.add('translate-y-0', 'opacity-100');
        } else {
            navbar.classList.add('-translate-y-full', 'opacity-0');
            navbar.classList.remove('translate-y-0', 'opacity-100');
        }
    });

    // 3. Mobile Menu Toggle
    menuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
    });

    // 4. Handle Back/Forward Buttons
    window.addEventListener('popstate', (event) => {
        const sectionId = event.state?.section;
        if (sectionId) {
            document.getElementById(sectionId)?.scrollIntoView({ behavior: 'smooth' });
        } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    });
</script>