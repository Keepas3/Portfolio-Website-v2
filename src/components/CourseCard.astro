---
// src/components/CourseCard.astro
import { Image } from 'astro:assets';
const { name, code, iconPath } = Astro.props;

const icons = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/*.{png,jpg,svg}');
---

<div class="flex items-center gap-4 p-4 bg-white dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-700 shadow-sm dark:shadow-none hover:shadow-md dark:hover:shadow-[0_0_15px_rgba(0,0,0,0.3)] transition-all duration-300">
    <div class="w-10 h-10 shrink-0">
        {iconPath && icons[iconPath] && (
            <Image src={icons[iconPath]()} alt={name} class="w-full h-full object-contain" />
        )}
    </div>
    <div>
        <h4 class="font-bold text-slate-800 dark:text-white leading-tight transition-colors duration-300">{name}</h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 uppercase font-mono mt-1 transition-colors duration-300">{code}</p>
    </div>
</div>