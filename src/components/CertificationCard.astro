---
interface Props {
  name: string;
  issuer: string;
  status: 'Earned' | 'In Progress';
  dateEarned: string | null;
  expiryDate: string | null;
  credentialUrl: string | null;
  badgeImageUrl: string | null;
}

const { name, issuer, status, dateEarned, expiryDate, credentialUrl, badgeImageUrl } = Astro.props;

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  const [year, month] = dateStr.split('-');
  const d = new Date(Number(year), Number(month) - 1);
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<div class="flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden">
  <!-- Badge area -->
  <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-700/50 p-6 min-h-[120px]">
    {badgeImageUrl ? (
      <img
        src={badgeImageUrl}
        alt={`${name} badge`}
        class="w-24 h-24 object-contain"
      />
    ) : (
      <div class="w-20 h-20 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center">
        <i class="bx bxs-award text-4xl text-blue-500 dark:text-blue-400"></i>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-start justify-between gap-2 mb-1">
      <h3 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
        {name}
      </h3>
      {status === 'In Progress' && (
        <span class="flex-shrink-0 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 rounded-full">
          In Progress
        </span>
      )}
    </div>

    <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{issuer}</p>

    {(dateEarned || expiryDate) && (
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-400 dark:text-slate-500 mb-4">
        {dateEarned && (
          <span class="flex items-center gap-1">
            <i class="bx bx-calendar-check text-green-500"></i>
            Earned {formatDate(dateEarned)}
          </span>
        )}
        {expiryDate && (
          <span class="flex items-center gap-1">
            <i class="bx bx-calendar-x text-slate-400"></i>
            Expires {formatDate(expiryDate)}
          </span>
        )}
      </div>
    )}

    {credentialUrl && (
      <div class="mt-auto">
        <a
          href={credentialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
        >
          <i class="bx bx-badge-check text-sm"></i>
          Verify Credential
        </a>
      </div>
    )}
  </div>
</div>
